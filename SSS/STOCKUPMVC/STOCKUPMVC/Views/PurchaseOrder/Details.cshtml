@model STOCKUPMVC.Models.PurchaseOrder
@{
    ViewData["Title"] = "Purchase Order Details";
}

<h2>Purchase Order #@Model.POID</h2>

<div>
    <p><strong>Supplier:</strong> @Model.Supplier?.Name</p>
    <p><strong>Warehouse:</strong> @Model.Warehouse?.Name</p>
    <p><strong>Status:</strong> @Model.Status</p>
    <p><strong>Total Amount:</strong> @Model.TotalAmount.ToString("C")</p>
    <p><strong>Order Time:</strong> @Model.OrderTime.ToString("yyyy-MM-dd HH:mm")</p>
</div>

<h4>Items</h4>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Product</th>
            <th>Quantity</th>
            <th>Unit Price</th>
            <th>Total</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.OrderItems)
        {
            <tr>
                <td>@item.Product?.Name</td>
                <td>@item.Quantity</td>
                <td>@item.UnitPrice.ToString("C")</td>
                <td>@(item.Quantity* item.UnitPrice).ToString("C")</td>
            </tr>
        }
    </tbody>
</table>

<a class="btn btn-secondary" asp-action="List">Back to List</a>
