@model STOCKUPMVC.ViewModels.DashboardViewModel

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Dashboard";
}

<h2>@ViewData["Title"]</h2>

<!-- Dashboard Metric Cards -->
<div class="row g-4 mb-4">

    <!-- Products Count -->
    <div class="col-md-4">
        <div class="card shadow-sm p-3 h-100">
            <div class="text-center">
                <div class="fs-1 mb-2">📦</div>
                <h5>Total Products</h5>
                <h2 class="fw-bold">@Model.ProductCount</h2>
            </div>
        </div>
    </div>

    <!-- Warehouses Count -->
    <div class="col-md-4">
        <div class="card shadow-sm p-3 h-100">
            <div class="text-center">
                <div class="fs-1 mb-2">🏭</div>
                <h5>Total Warehouses</h5>
                <h2 class="fw-bold">@Model.WarehouseCount</h2>
            </div>
        </div>
    </div>

    <!-- Pending Sales Orders -->
    <div class="col-md-4">
        <div class="card shadow-sm p-3 h-100">
            <div class="text-center">
                <div class="fs-1 mb-2">🕒</div>
                <h5>Pending Sales Orders</h5>
                <h2 class="fw-bold text-warning">@Model.PendingSalesOrderCount</h2>
            </div>
        </div>
    </div>

</div>

<!-- Recent Sales Orders Table -->
<div class="card shadow-sm border-0">
    <div class="card-header bg-white">
        <h5 class="fw-bold mb-0">Recent Sales Orders</h5>
    </div>

    <div class="card-body">
        <table class="table table-hover">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Customer</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model.RecentSalesOrders)
                {
                    <tr>
                        <td>@order.OrderID</td>
                        <td>@order.Customer?.Name</td>
                        <td>@order.OrderDate.ToShortDateString()</td>
                        <td>
                            @if (order.Status == "Pending")
                            {
                                <span class="badge bg-warning">Pending</span>
                            }
                            else if (order.Status == "Completed")
                            {
                                <span class="badge bg-success">Completed</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@order.Status</span>
                            }
                        </td>
                        <td>@order.TotalAmount</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Styles {
    <style>
        .card {
            border-radius: 10px;
        }

        .fs-1 {
            font-size: 3rem !important;
        }
    </style>
}
